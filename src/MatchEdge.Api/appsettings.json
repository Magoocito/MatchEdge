{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SofaScore": {
    "BaseUrl": "https://www.sofascore.com/api/v1/"
  },
  "MatchModel": {
    "HomeAdvantageFactor": 1.58
  },
  "SofaScoreCache": {
    "FinishedMatchesTtlDays": 30,
    "UpcomingMatchesTtlHours": 1,
    "LiveMatchesTtlMinutes": 2
  }
}
