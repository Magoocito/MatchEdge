# Modern Git defaults for cross-platform .NET development
* text=auto

*.cs     text diff=csharp
*.csproj text eol=lf
*.props  text eol=lf
*.targets text eol=lf
*.sln    text eol=crlf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.snk binary
